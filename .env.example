# Copia este archivo a .env y rellena los valores. No subas .env a Git.
# cp .env.example .env

# Linear (obligatorio para automatización)
LINEAR_API_KEY=

# Estado en el que deben estar las historias para generar casos (ej: TC Generator)
LINEAR_TARGET_STATE=TC Generator

# Estado al que mover el issue tras generar (ej: Ready for QA). Dejar vacío para no cambiar.
LINEAR_STATE_AFTER_SUCCESS=Ready for QA

# IDs de equipos separados por coma (vacío = todos)
# LINEAR_TEAM_IDS=

# GitHub: repo por defecto (owner/repo o URL) si el issue no tiene URL
# GITHUB_DEFAULT_REPO=

# Token de GitHub para repos privados (opcional)
# GITHUB_TOKEN=
